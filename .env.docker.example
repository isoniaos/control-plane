# Local Docker Compose host ports.
CONTROL_PLANE_API_PORT=3000
CONTROL_PLANE_POSTGRES_PORT=5433
CONTROL_PLANE_IPFS_SWARM_PORT=4001
CONTROL_PLANE_IPFS_API_PORT=5001
CONTROL_PLANE_IPFS_GATEWAY_PORT=8080

# Local database credentials used by docker-compose.local.yml.
CONTROL_PLANE_POSTGRES_DB=control-plane
CONTROL_PLANE_POSTGRES_USER=postgres
CONTROL_PLANE_POSTGRES_PASSWORD=secret

# Control Plane runtime settings.
CHAIN_ID=31337
RPC_URL=http://host.docker.internal:8545
ISONIA_CORE_ADDRESS=
ISONIA_PROPOSALS_ADDRESS=
ISONIA_PROTOCOL_PROFILE=current
ISONIA_DEPLOYMENT_CAPABILITIES_JSON=
START_BLOCK=0
CONFIRMATIONS=0
BLOCK_RANGE_SIZE=1000
POLL_INTERVAL_MS=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=false

# Container process controls.
CONTROL_PLANE_MIGRATE_ON_START=true
CONTROL_PLANE_INDEXER_ENABLED=true
CONTROL_PLANE_PROJECTIONS_ENABLED=true
