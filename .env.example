NODE_ENV=development
API_PORT=3000

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=control-plane
PG_USER=postgres
PG_PASSWORD=secret
# DATABASE_URL=postgres://postgres:secret@localhost:5432/control-plane

CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Set these to the addresses from evm-contracts/ignition/deployments/chain-31337/deployed_addresses.json.
GOV_CORE_ADDRESS=
GOV_PROPOSALS_ADDRESS=
# Set to v0.7.0-alpha.1 only when the configured addresses use v0.7-compatible evm-contracts.
EVM_CONTRACTS_VERSION=
START_BLOCK=0
CONFIRMATIONS=0
BLOCK_RANGE_SIZE=1000
POLL_INTERVAL_MS=5000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=false
