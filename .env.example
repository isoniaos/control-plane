NODE_ENV=development
API_PORT=3000

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=control-plane
PG_USER=postgres
PG_PASSWORD=secret
# DATABASE_URL=postgres://postgres:secret@localhost:5432/control-plane

CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Set these to the addresses from evm-contracts/ignition/deployments/chain-31337/deployed_addresses.json.
ISONIA_CORE_ADDRESS=
ISONIA_PROPOSALS_ADDRESS=
# Runtime capabilities come from deployment/profile evidence, not package version strings.
ISONIA_PROTOCOL_PROFILE=current
# Optional deployment manifest capabilities override the profile when supplied.
# Example: {"activation":{"contractBatch":true},"finalization":{"organization":true}}
ISONIA_DEPLOYMENT_CAPABILITIES_JSON=
START_BLOCK=0
CONFIRMATIONS=0
BLOCK_RANGE_SIZE=1000
POLL_INTERVAL_MS=5000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=false
